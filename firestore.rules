rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    match /machines/{machineId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
                    request.resource.data.name is string && 
                    request.resource.data.name.size() > 0 &&
                    request.resource.data.name.size() <= 120 &&
                    (request.resource.data.category is string || request.resource.data.category is list);
      allow update: if isSignedIn() && 
                    request.resource.data.name is string && 
                    request.resource.data.name.size() > 0;
      allow delete: if isSignedIn();
    }
    
    match /userProfiles/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    
    match /workoutLogs/{logId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    match /bodyMetrics/{metricId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
